@model WebApplication1.ViewModels.OrderVM

@{
    ViewData["Title"] = "Create";
}

<h1>[新增 OrderVM</h1>

<h4></h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="MemberName" class="control-label"></label>
                <input asp-for="MemberName" class="form-control" />
                <span asp-validation-for="MemberName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="OrderTime" class="control-label"></label>
                <input asp-for="OrderTime" class="form-control" />
                <span asp-validation-for="OrderTime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Total" class="control-label"></label>
                <input asp-for="Total" class="form-control" />
                <span asp-validation-for="Total" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <input type="submit" value="存檔" class="btn btn-primary" />
                <a class="btn btn-secondary" asp-action="Index">回清單業</a>
            </div>
        </form>
    </div>
</div>



